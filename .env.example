# OpenAI-compatible chat endpoint. Use the model/API used by your course.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional for OpenAI-compatible providers:
# OPENAI_BASE_URL=https://your-provider.example/v1
# Local Ollama instead: OPENAI_API_KEY=ollama, OPENAI_BASE_URL=http://localhost:11434/v1,
# OPENAI_MODEL=qwen3:8b and LLM_REASONING_EFFORT=none (turns off qwen3's thinking).
# LLM_REASONING_EFFORT=none

# Optional automatic fallback, used when the model above fails (no credits, bad key, offline).
# FALLBACK_OPENAI_BASE_URL=http://localhost:11434/v1
# FALLBACK_OPENAI_MODEL=llama3.2:3b
# FALLBACK_LLM_REASONING_EFFORT=

# Qdrant server (the local Docker container by default).
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=subjectmate

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_QUERY_PROMPT="Represent this sentence for searching relevant passages: "
CHUNK_SIZE=850
CHUNK_OVERLAP=120
# Pages/slides shorter than this are merged into the next one from the same file.
MIN_SECTION_CHARS=200
RETRIEVAL_K=6
# Candidates considered before picking RETRIEVAL_K diverse passages (MMR).
RETRIEVAL_FETCH_K=24
MMR_DIVERSITY=0.3
# Passages below this cosine similarity are never used as evidence.
MIN_RELEVANCE_SCORE=0.5
# Answer only if the best passage reaches this (off-topic questions peaked at 0.64, course
# questions started at 0.69 with bge-small). Recalibrate if you change the embedding model.
MIN_TOP_SCORE=0.66
